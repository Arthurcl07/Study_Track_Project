// Schema derivado de docs/modelo-dominio.md (ADR-002, ADR-004).
// SPEC-001: Usuario. SPEC-002: Disciplina, Turma e matrícula (N:M).
// SPEC-003: Avaliacao (estrutura), Nota, Frequencia e IndicadorAcademico.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// INV-001-01: exatamente um perfil dentre Estudante, Professor ou Coordenador (RB-01).
enum Perfil {
  Estudante
  Professor
  Coordenador
}

model Usuario {
  id        String @id @default(uuid())
  nome      String
  email     String @unique
  // INV-001-02: somente o hash bcrypt é armazenado, nunca a senha em texto puro (RNF-02).
  senhaHash String
  perfil    Perfil

  turmasLecionadas  Turma[]              @relation("ProfessorDaTurma")
  turmasCoordenadas Turma[]              @relation("CoordenadorDaTurma")
  matriculas        Matricula[]
  notas             Nota[]
  frequencias       Frequencia[]
  indicadores       IndicadorAcademico[]
}

model Disciplina {
  id           String  @id @default(uuid())
  nome         String
  // Inteiro maior que zero (OPEN-009); garantido também por CHECK na migração.
  cargaHoraria Int
  turmas       Turma[]
}

// INV-002-02: toda turma tem exatamente 1 disciplina e 1 professor responsável.
// INV-002-03: de 0 a 1 coordenador responsável.
model Turma {
  id            String      @id @default(uuid())
  nome          String
  periodo       String
  disciplinaId  String
  disciplina    Disciplina  @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  professorId   String
  professor     Usuario     @relation("ProfessorDaTurma", fields: [professorId], references: [id], onDelete: Restrict)
  coordenadorId String?
  coordenador   Usuario?    @relation("CoordenadorDaTurma", fields: [coordenadorId], references: [id], onDelete: SetNull)
  matriculas    Matricula[]
  avaliacoes    Avaliacao[]
  frequencias   Frequencia[]
  indicadores   IndicadorAcademico[]

  @@index([professorId])
  @@index([coordenadorId])
}

// INV-002-04: matrícula N:M entre estudantes e turmas, sem duplicidade.
model Matricula {
  estudanteId String
  estudante   Usuario @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId     String
  turma       Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([estudanteId, turmaId])
  @@index([turmaId])
}

// RB-09: a situação é sempre exatamente uma entre Normal, Atenção e Risco.
enum Situacao {
  Normal
  Atencao @map("Atenção")
  Risco
}

// Estrutura usada pelo cálculo da média (OPEN-002). O cadastro de avaliações é da SPEC-004.
model Avaliacao {
  id      String   @id @default(uuid())
  turmaId String
  turma   Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  nome    String
  // Peso maior que zero (OPEN-002); garantido também por CHECK na migração.
  peso    Float
  data    DateTime
  notas   Nota[]

  @@index([turmaId])
}

// Cada nota pertence a exatamente 1 avaliação e 1 estudante (modelo de domínio).
model Nota {
  id           String    @id @default(uuid())
  avaliacaoId  String
  avaliacao    Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  estudanteId  String
  estudante    Usuario   @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  // De 0 a 10 (OPEN-002); garantido também por CHECK na migração.
  valor        Float
  dataRegistro DateTime  @default(now())

  @@unique([avaliacaoId, estudanteId])
  @@index([estudanteId])
}

// Exatamente 1 registro de frequência vigente por estudante e turma (modelo de domínio).
model Frequencia {
  id           String   @id @default(uuid())
  estudanteId  String
  estudante    Usuario  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId      String
  turma        Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  // De 0 a 100 (OPEN-002); garantido também por CHECK na migração.
  percentual   Float
  atualizadaEm DateTime @updatedAt

  @@unique([estudanteId, turmaId])
}

// INV-003-05: exatamente 1 indicador vigente por estudante e turma (índice único composto, DA-05).
model IndicadorAcademico {
  id              String   @id @default(uuid())
  estudanteId     String
  estudante       Usuario  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId         String
  turma           Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  // Vazio quando o estudante ainda não tem nota (OPEN-002).
  media           Float?
  // Vazio quando ainda não há registro de frequência (OPEN-002).
  frequenciaAtual Float?
  situacao        Situacao
  atualizadoEm    DateTime

  @@unique([estudanteId, turmaId])
  @@index([turmaId])
}
