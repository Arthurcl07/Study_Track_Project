// Schema derivado de docs/modelo-dominio.md (ADR-002, ADR-004).
// SPEC-001: Usuario. SPEC-002: Disciplina, Turma e matrícula (N:M).
// SPEC-003: Avaliacao (estrutura), Nota, Frequencia e IndicadorAcademico.
// SPEC-005: Atividade e Entrega (status da entrega é derivado na leitura, OPEN-010).
// SPEC-008: PlanoRecuperacao e ItemPlano (OPEN-021; progresso derivado dos itens, RB-12).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// INV-001-01: exatamente um perfil dentre Estudante, Professor ou Coordenador (RB-01).
enum Perfil {
  Estudante
  Professor
  Coordenador
  // SPEC-010 / OPEN-025: só gestão de contas, sem acesso a dados acadêmicos (RB-13).
  Administrador
}

model Usuario {
  id        String @id @default(uuid())
  nome      String
  email     String @unique
  // INV-001-02: somente o hash bcrypt é armazenado, nunca a senha em texto puro (RNF-02).
  senhaHash String
  perfil    Perfil
  // SPEC-010 / RB-14: conta inativa não entra nem usa sessão já emitida; os dados permanecem.
  ativo     Boolean @default(true)

  turmasLecionadas    Turma[]              @relation("ProfessorDaTurma")
  turmasCoordenadas   Turma[]              @relation("CoordenadorDaTurma")
  matriculas          Matricula[]
  notas               Nota[]
  frequencias         Frequencia[]
  indicadores         IndicadorAcademico[]
  entregas            Entrega[]
  planosComoEstudante PlanoRecuperacao[]   @relation("EstudanteDoPlano")
  planosComoProfessor PlanoRecuperacao[]   @relation("ProfessorDoPlano")
}

model Disciplina {
  id           String  @id @default(uuid())
  nome         String
  // Inteiro maior que zero (OPEN-009); garantido também por CHECK na migração.
  cargaHoraria Int
  turmas       Turma[]
}

// INV-002-02: toda turma tem exatamente 1 disciplina e 1 professor responsável.
// INV-002-03: de 0 a 1 coordenador responsável.
model Turma {
  id            String               @id @default(uuid())
  nome          String
  periodo       String
  disciplinaId  String
  disciplina    Disciplina           @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  professorId   String
  professor     Usuario              @relation("ProfessorDaTurma", fields: [professorId], references: [id], onDelete: Restrict)
  coordenadorId String?
  coordenador   Usuario?             @relation("CoordenadorDaTurma", fields: [coordenadorId], references: [id], onDelete: SetNull)
  matriculas    Matricula[]
  avaliacoes    Avaliacao[]
  frequencias   Frequencia[]
  indicadores   IndicadorAcademico[]
  atividades    Atividade[]
  planos        PlanoRecuperacao[]

  @@index([professorId])
  @@index([coordenadorId])
}

// INV-002-04: matrícula N:M entre estudantes e turmas, sem duplicidade.
model Matricula {
  estudanteId String
  estudante   Usuario @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId     String
  turma       Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([estudanteId, turmaId])
  @@index([turmaId])
}

// RB-09: a situação é sempre exatamente uma entre Normal, Atenção e Risco.
enum Situacao {
  Normal
  Atencao @map("Atenção")
  Risco
}

// Estrutura usada pelo cálculo da média (OPEN-002). O cadastro de avaliações é da SPEC-004.
model Avaliacao {
  id      String   @id @default(uuid())
  turmaId String
  turma   Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  nome    String
  // Peso maior que zero (OPEN-002); garantido também por CHECK na migração.
  peso    Float
  data    DateTime
  notas   Nota[]

  @@index([turmaId])
}

// Cada nota pertence a exatamente 1 avaliação e 1 estudante (modelo de domínio).
model Nota {
  id           String    @id @default(uuid())
  avaliacaoId  String
  avaliacao    Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  estudanteId  String
  estudante    Usuario   @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  // De 0 a 10 (OPEN-002); garantido também por CHECK na migração.
  valor        Float
  dataRegistro DateTime  @default(now())

  @@unique([avaliacaoId, estudanteId])
  @@index([estudanteId])
}

// Exatamente 1 registro de frequência vigente por estudante e turma (modelo de domínio).
model Frequencia {
  id           String   @id @default(uuid())
  estudanteId  String
  estudante    Usuario  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId      String
  turma        Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  // De 0 a 100 (OPEN-002); garantido também por CHECK na migração.
  percentual   Float
  atualizadaEm DateTime @updatedAt

  @@unique([estudanteId, turmaId])
}

// INV-003-05: exatamente 1 indicador vigente por estudante e turma (índice único composto, DA-05).
model IndicadorAcademico {
  id              String   @id @default(uuid())
  estudanteId     String
  estudante       Usuario  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId         String
  turma           Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  // Vazio quando o estudante ainda não tem nota (OPEN-002).
  media           Float?
  // Vazio quando ainda não há registro de frequência (OPEN-002).
  frequenciaAtual Float?
  situacao        Situacao
  atualizadoEm    DateTime

  @@unique([estudanteId, turmaId])
  @@index([turmaId])
}

// SPEC-005 / RF-08: atividade com descrição e prazo, de exatamente 1 turma (modelo de domínio).
model Atividade {
  id        String    @id @default(uuid())
  turmaId   String
  turma     Turma     @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  descricao String
  // Só a data: o prazo vale até o fim do dia, horário de Brasília (OPEN-010).
  prazo     DateTime  @db.Date
  criadaEm  DateTime  @default(now())
  entregas  Entrega[]

  @@index([turmaId])
}

// SPEC-005 / OPEN-003: entrega registrada pelo professor. INV-005-03: no máximo 1 por estudante e atividade.
// O status (No prazo, Pendente, Atrasada) não é gravado: é calculado na leitura (OPEN-010, INV-005-06).
model Entrega {
  id           String    @id @default(uuid())
  atividadeId  String
  atividade    Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  estudanteId  String
  estudante    Usuario   @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  dataEntrega  DateTime  @db.Date
  registradaEm DateTime  @default(now())

  @@unique([atividadeId, estudanteId])
  @@index([estudanteId])
}

enum StatusPlano {
  Ativo
  Encerrado
}

// SPEC-008 / RB-11: plano de 1 estudante, 1 turma e exatamente 1 professor (o da turma).
// INV-008-05: no máximo 1 plano Ativo por estudante e turma — índice único parcial na migração.
model PlanoRecuperacao {
  id          String      @id @default(uuid())
  estudanteId String
  estudante   Usuario     @relation("EstudanteDoPlano", fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId     String
  turma       Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  professorId String
  professor   Usuario     @relation("ProfessorDoPlano", fields: [professorId], references: [id], onDelete: Cascade)
  status      StatusPlano @default(Ativo)
  criadoEm    DateTime    @default(now())
  encerradoEm DateTime?
  itens       ItemPlano[]

  @@index([turmaId])
  @@index([estudanteId])
}

// OPEN-021: item próprio do plano, marcado como concluído pelo professor (OPEN-003).
model ItemPlano {
  id          String           @id @default(uuid())
  planoId     String
  plano       PlanoRecuperacao @relation(fields: [planoId], references: [id], onDelete: Cascade)
  descricao   String
  ordem       Int
  concluido   Boolean          @default(false)
  concluidoEm DateTime?

  @@index([planoId])
}
