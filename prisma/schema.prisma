// Schema derivado de docs/modelo-dominio.md (ADR-002, ADR-004).
// SPEC-001: Usuario. SPEC-002: Disciplina, Turma e matrícula (N:M).
// SPEC-003: Avaliacao (estrutura), Nota, Frequencia e IndicadorAcademico.
// SPEC-005: Atividade e Entrega (status da entrega é derivado na leitura, OPEN-010).
// SPEC-008: PlanoRecuperacao e ItemPlano (OPEN-021; progresso derivado dos itens, RB-12).
// SPEC-015: Curso, grade Curso–Disciplina (N:M), turma e estudante de um curso (OPEN-030 a OPEN-033).
// SPEC-016: Usuario.criadaEm (dashboard do administrador, RF-25).
// SPEC-025: Comunicado (OPEN-047).
// SPEC-022: Notificacao (OPEN-043).
// SPEC-019: RegistroAuditoria (OPEN-039).
// SPEC-018: Aula e Presenca; a frequência passa a ser calculada pela chamada (OPEN-041).
// SPEC-017: PeriodoLetivo; Turma.periodo passa a ser chave estrangeira para o nome do período (OPEN-040).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// INV-001-01: exatamente um perfil dentre Estudante, Professor ou Coordenador (RB-01).
enum Perfil {
  Estudante
  Professor
  Coordenador
  // SPEC-010 / OPEN-025: só gestão de contas, sem acesso a dados acadêmicos (RB-13).
  Administrador
}

model Usuario {
  id          String   @id @default(uuid())
  nome        String
  email       String   @unique
  // INV-001-02: somente o hash bcrypt é armazenado, nunca a senha em texto puro (RNF-02).
  senhaHash   String
  perfil      Perfil
  // SPEC-010 / RB-14: conta inativa não entra nem usa sessão já emitida; os dados permanecem.
  ativo       Boolean  @default(true)
  // SPEC-011 / RB-15: conta criada pela tela usa senha provisória até o dono definir a própria.
  trocarSenha Boolean  @default(false)
  // SPEC-016 / RF-25: data de criação da conta (contas criadas recentemente no dashboard do administrador).
  criadaEm    DateTime @default(now())
  // SPEC-015 / RB-19 (INV-015-05): preenchido se e somente se o perfil for Estudante (CHECK na migração).
  cursoId     String?
  curso       Curso?   @relation("EstudanteDoCurso", fields: [cursoId], references: [id], onDelete: Restrict)

  turmasLecionadas           Turma[]              @relation("ProfessorDaTurma")
  cursosCoordenados          Curso[]              @relation("CoordenadorDoCurso")
  matriculas                 Matricula[]
  notas                      Nota[]
  frequencias                Frequencia[]
  indicadores                IndicadorAcademico[]
  entregas                   Entrega[]
  presencas                  Presenca[]
  registrosAuditoria         RegistroAuditoria[]
  notificacoes               Notificacao[]
  comunicados                Comunicado[]
  historicoComoEstudante     HistoricoNota[]      @relation("EstudanteDoHistorico")
  historicoComoAutor         HistoricoNota[]      @relation("AutorDoHistorico")
  planosComoEstudante        PlanoRecuperacao[]   @relation("EstudanteDoPlano")
  planosComoProfessor        PlanoRecuperacao[]   @relation("ProfessorDoPlano")
  // SPEC-033 / RB-33: ficha (número de matrícula e dados pessoais) só de estudante; criada por gatilho no banco.
  ficha                      FichaEstudante?
  // SPEC-032 / RB-31: abonos do estudante e os registrados pela secretaria.
  abonos                     Abono[]              @relation("AbonosDoEstudante")
  abonosRegistrados          Abono[]              @relation("AbonosRegistrados")
  // SPEC-027 / RB-27: pedidos de redefinição de senha.
  pedidosSenha               PedidoSenha[]        @relation("PedidosDaConta")
  pedidosResolvidos          PedidoSenha[]        @relation("PedidosResolvidos")
  // SPEC-036 / SPEC-042: requerimentos abertos e respondidos; aproveitamentos do estudante e os registrados.
  requerimentos              Requerimento[]       @relation("RequerimentosDoEstudante")
  requerimentosRespondidos   Requerimento[]       @relation("RequerimentosRespondidos")
  aproveitamentos            Aproveitamento[]     @relation("AproveitamentosDoEstudante")
  aproveitamentosRegistrados Aproveitamento[]     @relation("AproveitamentosRegistrados")

  @@index([cursoId])
}

// SPEC-015 / RB-17 (INV-015-01, INV-015-02): nome único e exatamente 1 coordenador; um coordenador
// pode coordenar vários cursos (OPEN-030).
model Curso {
  id            String              @id @default(uuid())
  nome          String              @unique
  coordenadorId String
  coordenador   Usuario             @relation("CoordenadorDoCurso", fields: [coordenadorId], references: [id], onDelete: Restrict)
  grade         CursoDisciplina[]
  turmas        Turma[]
  estudantes    Usuario[]           @relation("EstudanteDoCurso")
  auditoria     RegistroAuditoria[]
  comunicados   Comunicado[]
  preRequisitos PreRequisito[]

  @@index([coordenadorId])
}

// SPEC-015 / OPEN-031 (INV-015-04): grade do curso — a disciplina aparece no máximo 1 vez por curso
// e pode estar em vários cursos.
model CursoDisciplina {
  cursoId      String
  curso        Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  // SPEC-037 (OPEN-059): matriz do curso — semestre sugerido (1 a 10) e obrigatória ou optativa.
  semestre    Int?
  obrigatoria Boolean        @default(true)
  requisitos  PreRequisito[] @relation("RequisitosDaDisciplina")
  exigidaPor  PreRequisito[] @relation("DisciplinaExigida")

  @@id([cursoId, disciplinaId])
  @@index([disciplinaId])
}

model Disciplina {
  id              String            @id @default(uuid())
  nome            String
  // Inteiro maior que zero (OPEN-009); garantido também por CHECK na migração.
  cargaHoraria    Int
  turmas          Turma[]
  cursos          CursoDisciplina[]
  aproveitamentos Aproveitamento[]
}

// INV-002-02: toda turma tem exatamente 1 disciplina e 1 professor responsável.
// SPEC-015 / RB-18 (INV-015-03): exatamente 1 curso, cuja grade contém a disciplina da turma. O coordenador
// responsável é o do curso (substitui o coordenador gravado na turma, OPEN-030).
model Turma {
  id                 String               @id @default(uuid())
  nome               String
  // SPEC-017 / INV-017-01: exatamente 1 período letivo (o nome, que não muda, é a chave).
  periodo            String
  periodoLetivo      PeriodoLetivo        @relation(fields: [periodo], references: [nome], onDelete: Restrict, onUpdate: Cascade)
  disciplinaId       String
  disciplina         Disciplina           @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  professorId        String
  professor          Usuario              @relation("ProfessorDaTurma", fields: [professorId], references: [id], onDelete: Restrict)
  cursoId            String
  curso              Curso                @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  matriculas         Matricula[]
  avaliacoes         Avaliacao[]
  frequencias        Frequencia[]
  indicadores        IndicadorAcademico[]
  atividades         Atividade[]
  planos             PlanoRecuperacao[]
  aulas              Aula[]
  auditoria          RegistroAuditoria[]
  comunicados        Comunicado[]
  // SPEC-038 (OPEN-060): vagas para a rematrícula (vazio = sem limite).
  vagas              Int?
  // SPEC-039 (OPEN-061): diário de classe. Fechado ou homologado = turma somente leitura (RB-37).
  diario             StatusDiario         @default(Aberto)
  diarioFechadoEm    DateTime?
  diarioHomologadoEm DateTime?
  diarioObservacao   String?
  horarios           HorarioTurma[]
  requerimentos      Requerimento[]

  @@index([professorId])
  @@index([cursoId])
  @@index([periodo])
}

enum StatusPeriodo {
  Aberto
  Encerrado
}

// SPEC-017 / RB-20 (OPEN-040): turma de período encerrado é somente leitura. INV-017-02: nome único, AAAA/1 ou AAAA/2.
model PeriodoLetivo {
  id                String             @id @default(uuid())
  nome              String             @unique
  status            StatusPeriodo      @default(Aberto)
  criadoEm          DateTime           @default(now())
  encerradoEm       DateTime?
  turmas            Turma[]
  // SPEC-038 (OPEN-060): janela de rematrícula definida pela secretaria.
  rematriculaInicio DateTime?          @db.Date
  rematriculaFim    DateTime?          @db.Date
  eventos           EventoCalendario[]
}

// INV-002-04: matrícula N:M entre estudantes e turmas, sem duplicidade.
model Matricula {
  estudanteId String
  estudante   Usuario @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId     String
  turma       Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  // SPEC-031 / RB-30: matrícula trancada ou cancelada sai das listas de trabalho e fica no histórico.
  situacao   SituacaoMatricula   @default(Cursando)
  // SPEC-031: indicador e frequência pertencem à matrícula (filtro de matrícula cursando na própria query).
  indicador  IndicadorAcademico?
  frequencia Frequencia?

  @@id([estudanteId, turmaId])
  @@index([turmaId])
}

// RB-09: a situação é sempre exatamente uma entre Normal, Atenção e Risco.
enum Situacao {
  Normal
  Atencao @map("Atenção")
  Risco
}

// Estrutura usada pelo cálculo da média (OPEN-002). O cadastro de avaliações é da SPEC-004.
model Avaliacao {
  id            String          @id @default(uuid())
  turmaId       String
  turma         Turma           @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  nome          String
  // Peso maior que zero (OPEN-002); garantido também por CHECK na migração.
  peso          Float
  // SPEC-029 / RB-28 / RB-29: no máximo uma Substitutiva e um Exame por turma (índices parciais na migração).
  tipo          TipoAvaliacao   @default(Prova)
  data          DateTime
  notas         Nota[]
  historico     HistoricoNota[]
  requerimentos Requerimento[]

  @@index([turmaId])
}

// Cada nota pertence a exatamente 1 avaliação e 1 estudante (modelo de domínio).
model Nota {
  id           String    @id @default(uuid())
  avaliacaoId  String
  avaliacao    Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  estudanteId  String
  estudante    Usuario   @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  // De 0 a 10 (OPEN-002); garantido também por CHECK na migração.
  valor        Float
  dataRegistro DateTime  @default(now())

  @@unique([avaliacaoId, estudanteId])
  @@index([estudanteId])
}

// Exatamente 1 registro de frequência vigente por estudante e turma (modelo de domínio).
// SPEC-018 / RB-21: o percentual é calculado pela chamada (presenças ÷ aulas em que o estudante constou).
model Frequencia {
  id           String   @id @default(uuid())
  estudanteId  String
  estudante    Usuario  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId      String
  turma        Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  // De 0 a 100 (OPEN-002); garantido também por CHECK na migração.
  percentual   Float
  atualizadaEm DateTime @updatedAt

  matricula Matricula @relation(fields: [estudanteId, turmaId], references: [estudanteId, turmaId], onDelete: Cascade)

  @@unique([estudanteId, turmaId])
}

// INV-003-05: exatamente 1 indicador vigente por estudante e turma (índice único composto, DA-05).
model IndicadorAcademico {
  id              String   @id @default(uuid())
  estudanteId     String
  estudante       Usuario  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId         String
  turma           Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  // Vazio quando o estudante ainda não tem nota (OPEN-002).
  media           Float?
  // Vazio quando ainda não há registro de frequência (OPEN-002).
  frequenciaAtual Float?
  situacao        Situacao
  atualizadoEm    DateTime

  matricula Matricula @relation(fields: [estudanteId, turmaId], references: [estudanteId, turmaId], onDelete: Cascade)

  @@unique([estudanteId, turmaId])
  @@index([turmaId])
}

// SPEC-005 / RF-08: atividade com descrição e prazo, de exatamente 1 turma (modelo de domínio).
model Atividade {
  id        String    @id @default(uuid())
  turmaId   String
  turma     Turma     @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  descricao String
  // Só a data: o prazo vale até o fim do dia, horário de Brasília (OPEN-010).
  prazo     DateTime  @db.Date
  criadaEm  DateTime  @default(now())
  entregas  Entrega[]

  @@index([turmaId])
}

// SPEC-005 / OPEN-003: entrega registrada pelo professor. INV-005-03: no máximo 1 por estudante e atividade.
// O status (No prazo, Pendente, Atrasada) não é gravado: é calculado na leitura (OPEN-010, INV-005-06).
model Entrega {
  id           String    @id @default(uuid())
  atividadeId  String
  atividade    Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  estudanteId  String
  estudante    Usuario   @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  dataEntrega  DateTime  @db.Date
  registradaEm DateTime  @default(now())

  @@unique([atividadeId, estudanteId])
  @@index([estudanteId])
}

enum StatusPlano {
  Ativo
  Encerrado
}

// SPEC-008 / RB-11: plano de 1 estudante, 1 turma e exatamente 1 professor (o da turma).
// INV-008-05: no máximo 1 plano Ativo por estudante e turma — índice único parcial na migração.
model PlanoRecuperacao {
  id          String      @id @default(uuid())
  estudanteId String
  estudante   Usuario     @relation("EstudanteDoPlano", fields: [estudanteId], references: [id], onDelete: Cascade)
  turmaId     String
  turma       Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  professorId String
  professor   Usuario     @relation("ProfessorDoPlano", fields: [professorId], references: [id], onDelete: Cascade)
  status      StatusPlano @default(Ativo)
  criadoEm    DateTime    @default(now())
  encerradoEm DateTime?
  itens       ItemPlano[]

  @@index([turmaId])
  @@index([estudanteId])
}

// OPEN-021: item próprio do plano, marcado como concluído pelo professor (OPEN-003).
model ItemPlano {
  id          String           @id @default(uuid())
  planoId     String
  plano       PlanoRecuperacao @relation(fields: [planoId], references: [id], onDelete: Cascade)
  descricao   String
  ordem       Int
  concluido   Boolean          @default(false)
  concluidoEm DateTime?

  @@index([planoId])
}

// SPEC-013 / RB-16 (OPEN-028): um registro por lançamento ou alteração de nota, gravado na mesma
// transação da nota. Não há operação de edição nem de exclusão pela aplicação.
model HistoricoNota {
  id            String    @id @default(uuid())
  avaliacaoId   String
  avaliacao     Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  estudanteId   String
  estudante     Usuario   @relation("EstudanteDoHistorico", fields: [estudanteId], references: [id], onDelete: Cascade)
  autorId       String
  autor         Usuario   @relation("AutorDoHistorico", fields: [autorId], references: [id], onDelete: Cascade)
  // Vazio no lançamento; no lançamento e na alteração, de 0 a 10 (OPEN-002).
  valorAnterior Float?
  valorNovo     Float
  registradoEm  DateTime  @default(now())

  @@index([avaliacaoId])
  @@index([estudanteId])
}

// SPEC-018 / INV-018-01: no máximo 1 aula por turma e data (OPEN-041). Só a data: horário de Brasília.
model Aula {
  id           String     @id @default(uuid())
  turmaId      String
  turma        Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  data         DateTime   @db.Date
  // SPEC-028 / RB-21: de 1 a 4 aulas na mesma data (CHECK na migração).
  numero       Int        @default(1)
  // SPEC-039 (OPEN-061): conteúdo da aula.
  conteudo     String?
  registradaEm DateTime   @default(now())
  presencas    Presenca[]

  @@unique([turmaId, data, numero])
}

// SPEC-018 / INV-018-02: uma presença (ou falta) por estudante e aula.
model Presenca {
  aulaId      String
  aula        Aula    @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  estudanteId String
  estudante   Usuario @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  presente    Boolean

  @@id([aulaId, estudanteId])
  @@index([estudanteId])
}

enum CategoriaAuditoria {
  Administrativa
  Academica      @map("Acadêmica")
}

// SPEC-019 / RB-22 (OPEN-039): um registro por escrita, gravado na mesma transação. Não há operação de edição
// nem de exclusão pela aplicação (INV-019-02). Registro acadêmico tem o curso (escopo do coordenador, INV-019-03).
model RegistroAuditoria {
  id           String             @id @default(uuid())
  categoria    CategoriaAuditoria
  acao         String
  descricao    String
  // Valores anteriores e novos, sem senha nem hash (INV-019-05).
  antes        Json?
  depois       Json?
  autorId      String
  autor        Usuario            @relation(fields: [autorId], references: [id], onDelete: Cascade)
  cursoId      String?
  curso        Curso?             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  turmaId      String?
  turma        Turma?             @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  registradoEm DateTime           @default(now())

  @@index([categoria, registradoEm])
  @@index([cursoId, registradoEm])
}

enum TipoNotificacao {
  Risco
  Nota
  Plano
  Prazo
  Comunicado
  // SPEC-036 e SPEC-039.
  Requerimento
  Diario
}

// SPEC-022 / RB-23 (OPEN-043): notificação gravada, de exatamente 1 destinatário, o único que a vê e marca como
// lida. A chave (só para prazo) garante no máximo uma notificação por estudante e atividade (INV-022-03).
model Notificacao {
  id        String          @id @default(uuid())
  usuarioId String
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacao
  titulo    String
  texto     String
  link      String
  chave     String?         @unique
  criadaEm  DateTime        @default(now())
  lidaEm    DateTime?

  @@index([usuarioId, lidaEm])
}

// SPEC-025 / RB-26 (OPEN-047): aviso de um professor ou coordenador para exatamente um alcance: 1 turma ou 1 curso
// (INV-025-01, CHECK na migração). Só o autor apaga.
model Comunicado {
  id       String   @id @default(uuid())
  autorId  String
  autor    Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  turmaId  String?
  turma    Turma?   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  cursoId  String?
  curso    Curso?   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  titulo   String
  texto    String
  criadoEm DateTime @default(now())

  @@index([turmaId])
  @@index([cursoId])
}

// SPEC-031 / RB-30 (OPEN-053).
enum SituacaoMatricula {
  Cursando
  Trancada
  Cancelada
}

// SPEC-029 (OPEN-051).
enum TipoAvaliacao {
  Prova
  Trabalho
  Substitutiva
  Exame
}

// SPEC-031 / RB-30 (OPEN-053): situação do estudante no curso.
enum SituacaoCurso {
  Ativo
  Trancado
  Transferido
  Cancelado
  Concluido   @map("Concluído")
}

// SPEC-033 / RB-33 (OPEN-055): exatamente 1 por estudante, criada por gatilho na inserção do Usuario Estudante
// (número = ano + sequência de 4 dígitos, único e imutável). Dados pessoais opcionais; CPF único.
model FichaEstudante {
  estudanteId         String        @id
  estudante           Usuario       @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  numeroMatricula     String        @unique
  cpf                 String?       @unique
  dataNascimento      DateTime?     @db.Date
  telefone            String?
  responsavelNome     String?
  responsavelTelefone String?
  situacaoCurso       SituacaoCurso @default(Ativo)
  situacaoDesde       DateTime      @default(now()) @db.Date
  situacaoMotivo      String?
}

// SPEC-032 / RB-31 (OPEN-054).
enum MotivoAbono {
  AtestadoMedico
  ExerciciosDomiciliares
  LicencaMaternidade
  ServicoMilitar
  Outro
}

model Abono {
  id          String      @id @default(uuid())
  estudanteId String
  estudante   Usuario     @relation("AbonosDoEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  inicio      DateTime    @db.Date
  fim         DateTime    @db.Date
  motivo      MotivoAbono
  observacao  String?
  autorId     String
  autor       Usuario     @relation("AbonosRegistrados", fields: [autorId], references: [id], onDelete: Cascade)
  criadoEm    DateTime    @default(now())

  @@index([estudanteId])
}

// SPEC-027 / RB-27 (OPEN-049): no máximo 1 pendente por conta (índice parcial na migração); a senha nunca é guardada aqui.
enum StatusPedidoSenha {
  Pendente
  Aprovado
  Recusado
}

model PedidoSenha {
  id             String            @id @default(uuid())
  usuarioId      String
  usuario        Usuario           @relation("PedidosDaConta", fields: [usuarioId], references: [id], onDelete: Cascade)
  status         StatusPedidoSenha @default(Pendente)
  criadoEm       DateTime          @default(now())
  resolvidoEm    DateTime?
  resolvidoPorId String?
  resolvidoPor   Usuario?          @relation("PedidosResolvidos", fields: [resolvidoPorId], references: [id], onDelete: SetNull)

  @@index([status, criadoEm])
}

// SPEC-033 (OPEN-055): registro único (id = 1, CHECK na migração) usado no cabeçalho dos documentos.
model Instituicao {
  id                    Int      @id @default(1)
  nome                  String
  cnpj                  String?
  endereco              String?
  cidadeUf              String?
  telefone              String?
  email                 String?
  responsavelSecretaria String?
  // Data URL (PNG ou JPG, até 200 KB).
  logotipo              String?
  atualizadaEm          DateTime @updatedAt
}

// SPEC-037 / RB-41 (OPEN-059): pré-requisito dentro da matriz de um curso (sem ciclo, conferido no domínio).
model PreRequisito {
  cursoId      String
  curso        Curso           @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  disciplinaId String
  requisitoId  String
  disciplina   CursoDisciplina @relation("RequisitosDaDisciplina", fields: [cursoId, disciplinaId], references: [cursoId, disciplinaId], onDelete: Cascade)
  requisito    CursoDisciplina @relation("DisciplinaExigida", fields: [cursoId, requisitoId], references: [cursoId, disciplinaId], onDelete: Cascade)

  @@id([cursoId, disciplinaId, requisitoId])
}

// SPEC-039 (OPEN-061).
enum StatusDiario {
  Aberto
  Fechado
  Homologado
}

// SPEC-040 / RB-38 (OPEN-062).
enum TipoEvento {
  InicioAulas
  FimAulas
  Feriado
  Recesso
  SemanaProvas
  Outro
}

model EventoCalendario {
  id            String        @id @default(uuid())
  periodo       String
  periodoLetivo PeriodoLetivo @relation(fields: [periodo], references: [nome], onDelete: Cascade, onUpdate: Cascade)
  tipo          TipoEvento
  titulo        String
  inicio        DateTime      @db.Date
  fim           DateTime      @db.Date

  @@index([periodo])
  @@index([inicio])
}

// SPEC-041 / RB-39 (OPEN-063).
model Sala {
  id         String         @id @default(uuid())
  nome       String         @unique
  capacidade Int
  horarios   HorarioTurma[]
}

model HorarioTurma {
  id        String @id @default(uuid())
  turmaId   String
  turma     Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  // 1 = segunda ... 6 = sábado; horas "HH:MM".
  diaSemana Int
  inicio    String
  fim       String
  salaId    String
  sala      Sala   @relation(fields: [salaId], references: [id], onDelete: Restrict)

  @@index([turmaId])
  @@index([salaId, diaSemana])
}

// SPEC-036 / RB-34 (OPEN-058).
enum TipoRequerimento {
  RevisaoProva
  SegundaChamada
  DeclaracaoMatricula
  // SPEC-044: Trancamento é o do curso; TrancamentoDisciplina tranca a matrícula de uma turma.
  Trancamento
  Outro
  TrancamentoDisciplina
}

enum DestinoRequerimento {
  Professor
  Secretaria
}

enum StatusRequerimento {
  Aberto
  EmAnalise
  Deferido
  Indeferido
}

model Requerimento {
  id            String              @id @default(uuid())
  protocolo     String              @unique
  estudanteId   String
  estudante     Usuario             @relation("RequerimentosDoEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  tipo          TipoRequerimento
  destino       DestinoRequerimento
  turmaId       String?
  turma         Turma?              @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  avaliacaoId   String?
  avaliacao     Avaliacao?          @relation(fields: [avaliacaoId], references: [id], onDelete: SetNull)
  descricao     String
  status        StatusRequerimento  @default(Aberto)
  resposta      String?
  prazo         DateTime            @db.Date
  criadoEm      DateTime            @default(now())
  respondidoEm  DateTime?
  responsavelId String?
  responsavel   Usuario?            @relation("RequerimentosRespondidos", fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([estudanteId])
  @@index([status, prazo])
}

// SPEC-042 / RB-35 (OPEN-064): no máximo um por estudante e disciplina.
model Aproveitamento {
  id                String     @id @default(uuid())
  estudanteId       String
  estudante         Usuario    @relation("AproveitamentosDoEstudante", fields: [estudanteId], references: [id], onDelete: Cascade)
  disciplinaId      String
  disciplina        Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  instituicaoOrigem String
  disciplinaOrigem  String
  nota              Float?
  cargaHoraria      Int
  registradoEm      DateTime   @default(now())
  autorId           String
  autor             Usuario    @relation("AproveitamentosRegistrados", fields: [autorId], references: [id], onDelete: Cascade)

  @@unique([estudanteId, disciplinaId])
}
