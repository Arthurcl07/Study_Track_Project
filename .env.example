# Copie para .env e ajuste os valores. Nunca commite o .env real.
# Banco PostgreSQL local (o Prisma cria o banco "studytrack" se não existir).
DATABASE_URL="postgresql://postgres:troque-esta-senha@localhost:5432/studytrack?schema=public"
# Segredo para assinar o JWT da sessão (ADR-004). Use uma string aleatória longa (32+ caracteres).
JWT_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
